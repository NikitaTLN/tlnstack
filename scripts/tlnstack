#!/usr/bin/env bash
# tlnstack - install this repo's agent instructions and personal skills on a
# machine, and keep them in step with the repo.
#
# Usage: tlnstack [sync|check|capture] [--link|--copy] [--force] [--repo DIR]
#
#   sync (default)  install the repo's files into every target.
#   --check         show what sync would do; write nothing.
#   --capture       copy an installed file that was edited by hand back into the
#                   repo, so it can be committed. Refuses when targets disagree.
#   --link          symlink every target to the repo (default on Linux and
#                   macOS). One source of truth: `git pull` updates every harness.
#   --copy          copy the content instead (default on Windows, where symlinks
#                   need Developer Mode).
#   --force         overwrite a target that has local edits.
#   --repo DIR      use DIR as the repo root (default: this script's repo).
#
# Targets
#   instructions: ~/.claude/CLAUDE.md, ~/.claude-hub/CLAUDE.md,
#                 ~/.codex/AGENTS.md, ~/.codex-hub/AGENTS.md,
#                 ~/.config/opencode/AGENTS.md
#   skills:       ~/.claude/skills, ~/.claude-hub/skills,
#                 ~/.codex/skills, ~/.codex-hub/skills
#
# In copy mode a target is only overwritten when the installed copy still
# matches what the last sync installed. Hand edits are reported and left alone
# unless --force.
#
# Environment overrides: TLNSTACK_REPO, TLNSTACK_STATE, TLNSTACK_BIN,
# TLNSTACK_INSTALL (link|copy), TLNSTACK_CLAUDE_DIR, TLNSTACK_CLAUDE_HUB_DIR,
# TLNSTACK_CODEX_DIR, TLNSTACK_CODEX_HUB_DIR, TLNSTACK_OPENCODE_DIR.
set -euo pipefail

# macOS ships bash 3.2; this script uses associative arrays (bash 4+).
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  echo "tlnstack: needs bash 4 or newer (on macOS: brew install bash)" >&2
  exit 1
fi

self=$(readlink -f "${BASH_SOURCE[0]}")
REPO="${TLNSTACK_REPO:-$(cd "$(dirname "$self")/.." && pwd)}"
STATE="${TLNSTACK_STATE:-$HOME/.local/state/tlnstack-sync}"
BACKUPS="$STATE/backups"
BIN_DIR="${TLNSTACK_BIN:-$HOME/.local/bin}"

CLAUDE_DIR="${TLNSTACK_CLAUDE_DIR:-$HOME/.claude}"
CLAUDE_HUB_DIR="${TLNSTACK_CLAUDE_HUB_DIR:-$HOME/.claude-hub}"
CODEX_DIR="${TLNSTACK_CODEX_DIR:-$HOME/.codex}"
CODEX_HUB_DIR="${TLNSTACK_CODEX_HUB_DIR:-$HOME/.codex-hub}"
OPENCODE_DIR="${TLNSTACK_OPENCODE_DIR:-$HOME/.config/opencode}"

INSTRUCTION_TARGETS=(
  "$CLAUDE_DIR/CLAUDE.md"
  "$CLAUDE_HUB_DIR/CLAUDE.md"
  "$CODEX_DIR/AGENTS.md"
  "$CODEX_HUB_DIR/AGENTS.md"
  "$OPENCODE_DIR/AGENTS.md"
)
SKILL_TARGETS=(
  "$CLAUDE_DIR/skills"
  "$CLAUDE_HUB_DIR/skills"
  "$CODEX_DIR/skills"
  "$CODEX_HUB_DIR/skills"
)

# Symlinks work on Linux and macOS; on Windows they need Developer Mode, so
# default to a copy there.
default_install=link
case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) default_install=copy ;;
esac
INSTALL="${TLNSTACK_INSTALL:-$default_install}"

MODE=sync
FORCE=0

usage() {
  cat <<'EOF'
tlnstack - install this repo's agent instructions and personal skills.

Usage: tlnstack [sync|check|capture] [--link|--copy] [--force] [--repo DIR]

  sync (default)  install the repo's files into every target.
  --check         show what sync would do; write nothing.
  --capture       copy an installed file that was edited by hand back into the
                  repo, so it can be committed. Refuses when targets disagree.
  --link          symlink every target to the repo (default on Linux and macOS).
  --copy          copy the content instead (default on Windows).
  --force         overwrite a target that has local edits.
  --repo DIR      use DIR as the repo root (default: this script's repo).

Targets
  instructions: ~/.claude/CLAUDE.md, ~/.claude-hub/CLAUDE.md,
                ~/.codex/AGENTS.md, ~/.codex-hub/AGENTS.md,
                ~/.config/opencode/AGENTS.md
  skills:       ~/.claude/skills, ~/.claude-hub/skills,
                ~/.codex/skills, ~/.codex-hub/skills
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    sync) MODE=sync ;;
    check|--check) MODE=check ;;
    capture|--capture) MODE=capture ;;
    --link) INSTALL=link ;;
    --copy) INSTALL=copy ;;
    --force) FORCE=1 ;;
    --repo) shift; REPO="${1:?--repo needs a directory}" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "tlnstack: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

case "$INSTALL" in
  link|copy) ;;
  *) echo "tlnstack: TLNSTACK_INSTALL must be link or copy" >&2; exit 2 ;;
esac

SRC_INSTRUCTIONS="$REPO/agents/AGENTS.md"
SRC_SKILLS="$REPO/skills"

if [ ! -f "$SRC_INSTRUCTIONS" ]; then
  echo "tlnstack: $SRC_INSTRUCTIONS not found (is TLNSTACK_REPO right?)" >&2
  exit 1
fi

# Linux has sha256sum; macOS has shasum. Both print "<hash>  <path>", so the
# hashes (and the install records) match across systems.
if command -v sha256sum >/dev/null 2>&1; then SHA=(sha256sum); else SHA=(shasum -a 256); fi
if xargs -r true </dev/null >/dev/null 2>&1; then XARGS_R=(-r); else XARGS_R=(); fi
file_hash() { "${SHA[@]}" "$1" | cut -d' ' -f1; }
tree_hash() { (cd "$1" && find . -type f -print0 | sort -z | xargs -0 "${XARGS_R[@]}" "${SHA[@]}" | "${SHA[@]}") | cut -d' ' -f1; }
slug() { printf '%s' "$1" | "${SHA[@]}" | cut -c1-12; }
record_path() { printf '%s/%s' "$STATE" "$1"; }

hash_of() {
  if [ "$1" = tree ]; then tree_hash "$2"; else file_hash "$2"; fi
}

backup() {
  local path="$1"
  mkdir -p "$BACKUPS"
  local stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  cp -a "$path" "$BACKUPS/$(basename "$path").$stamp.$(slug "$path")"
}

# Classify one target. Echoes one of:
#   install    missing, will be created
#   current    already correct (a link to the source, or identical content)
#   update     content matches the last install, the repo moved on
#   convert    a copy that matches the source or the record; link it
#   relink     a link to the wrong place
#   adopt      exists but tlnstack never managed it; take it over
#   local-edit changed by hand; left alone unless --force
classify() {
  local kind="$1" src="$2" dest="$3" record="$4"
  local srcreal
  srcreal=$(readlink -f "$src")

  if [ "$INSTALL" = link ] && [ -L "$dest" ]; then
    local tgt
    tgt=$(readlink -f "$dest" 2>/dev/null || true)
    if [ "$tgt" = "$srcreal" ]; then echo current; else echo relink; fi
    return
  fi

  # In copy mode a symlink is not a real copy: convert it.
  if [ "$INSTALL" = copy ] && [ -L "$dest" ]; then
    echo convert
    return
  fi

  if [ ! -e "$dest" ]; then echo install; return; fi

  local new cur recorded
  new=$(hash_of "$kind" "$src")
  cur=$(hash_of "$kind" "$dest")
  recorded=$(cat "$record" 2>/dev/null || true)

  if [ "$cur" = "$new" ]; then
    if [ "$INSTALL" = link ]; then echo convert; else echo current; fi
  elif [ -z "$recorded" ]; then
    echo adopt
  elif [ "$cur" = "$recorded" ]; then
    if [ "$INSTALL" = link ]; then echo convert; else echo update; fi
  else
    echo local-edit
  fi
}

write_record() {
  local kind="$1" src="$2" record="$3"
  mkdir -p "$STATE"
  if [ "$INSTALL" = link ]; then
    printf 'link:%s\n' "$(readlink -f "$src")" > "$record"
  else
    printf '%s\n' "$(hash_of "$kind" "$src")" > "$record"
  fi
}

apply_target() {
  local kind="$1" src="$2" dest="$3" record="$4"

  if [ -L "$dest" ]; then
    backup "$dest"
    rm -f "$dest"
  fi

  if [ "$INSTALL" = link ]; then
    local srcreal
    srcreal=$(readlink -f "$src")
    if [ -e "$dest" ] || [ -L "$dest" ]; then backup "$dest"; fi
    rm -rf "$dest"
    mkdir -p "$(dirname "$dest")"
    ln -s "$srcreal" "$dest"
    write_record "$kind" "$src" "$record"
    return
  fi

  if [ "$kind" = file ]; then
    mkdir -p "$(dirname "$dest")"
    [ -e "$dest" ] && backup "$dest"
    cp -f "$src" "$dest"
  else
    [ -e "$dest" ] && backup "$dest"
    rm -rf "$dest"
    mkdir -p "$dest"
    cp -a "$src/." "$dest/"
  fi
  write_record "$kind" "$src" "$record"
}

link_self() {
  [ -d "$BIN_DIR" ] || mkdir -p "$BIN_DIR" 2>/dev/null || return 0
  local link="$BIN_DIR/tlnstack"
  if [ "$(readlink -f "$link" 2>/dev/null || true)" != "$self" ]; then
    ln -sf "$self" "$link" 2>/dev/null || return 0
    echo "linked   $link -> $self"
  fi
}

changed=0
skipped=0

do_sync() {
  local check=0
  [ "$MODE" = check ] && check=1

  echo "repo: $REPO"
  echo "mode: $INSTALL"

  local dest record action
  for dest in "${INSTRUCTION_TARGETS[@]}"; do
    record=$(record_path "inst-$(slug "$dest")")
    action=$(classify file "$SRC_INSTRUCTIONS" "$dest" "$record")
    if [ "$action" = local-edit ] && [ "$FORCE" = 1 ]; then action=force; fi
    handle "$action" file "$SRC_INSTRUCTIONS" "$dest" "$record" "$check"
    printf '%-10s %s\n' "$action" "$dest"
  done

  local src name target
  for src in "$SRC_SKILLS"/*/; do
    [ -d "$src" ] || continue
    name=$(basename "$src")
    for target in "${SKILL_TARGETS[@]}"; do
      if [ ! -d "$target" ]; then
        printf '%-10s %-16s %s (folder missing)\n' skip "$name" "$target"
        continue
      fi
      dest="$target/$name"
      record=$(record_path "skill-$(slug "$dest")")
      action=$(classify tree "$src" "$dest" "$record")
      if [ "$action" = local-edit ] && [ "$FORCE" = 1 ]; then action=force; fi
      handle "$action" tree "$src" "$dest" "$record" "$check"
      printf '%-10s %-16s %s\n' "$action" "$name" "$dest"
    done
  done

  if [ "$check" = 1 ]; then
    echo "(check only: nothing was written)"
  else
    link_self
    echo "done: $changed changed, $skipped left alone (local edits)"
    if [ "$skipped" -gt 0 ]; then
      echo "re-run with --force to overwrite local edits; backups go to $BACKUPS"
    fi
  fi
}

# Apply one classified action, or just count it when checking.
handle() {
  local action="$1" kind="$2" src="$3" dest="$4" record="$5" check="$6"

  case "$action" in
    install|update|convert|relink|adopt|force)
      changed=$((changed+1))
      if [ "$check" = 0 ]; then apply_target "$kind" "$src" "$dest" "$record"; fi
      ;;
    current)
      if [ "$check" = 0 ]; then write_record "$kind" "$src" "$record"; fi
      ;;
    local-edit)
      skipped=$((skipped+1))
      ;;
  esac
}

do_capture() {
  echo "repo: $REPO"

  # Instructions: targets edited by hand (differ from the repo and the record).
  local -A seen=()
  local dest record action cur
  for dest in "${INSTRUCTION_TARGETS[@]}"; do
    [ -e "$dest" ] || continue
    record=$(record_path "inst-$(slug "$dest")")
    action=$(classify file "$SRC_INSTRUCTIONS" "$dest" "$record")
    if [ "$action" = local-edit ]; then
      cur=$(file_hash "$dest")
      seen["$cur"]+="$dest "
    fi
  done
  if [ "${#seen[@]}" -eq 0 ]; then
    echo "instructions: nothing to capture (all targets match the repo)"
  elif [ "${#seen[@]}" -eq 1 ]; then
    local hash first=""
    for hash in "${!seen[@]}"; do first="${seen[$hash]%% *}"; done
    backup "$SRC_INSTRUCTIONS"
    cp -f "$first" "$SRC_INSTRUCTIONS"
    echo "instructions: captured $first -> $SRC_INSTRUCTIONS"
    echo "             (from: ${seen[$hash]% })"
  else
    echo "instructions: targets disagree; resolve by hand" >&2
    local h
    for h in "${!seen[@]}"; do echo "  ${seen[$h]% }" >&2; done
    return 1
  fi

  # Skills: same idea, per skill, including skills that exist only on a machine.
  local src name target
  declare -A names=()
  for src in "$SRC_SKILLS"/*/; do
    [ -d "$src" ] || continue
    names["$(basename "$src")"]=1
  done
  for target in "${SKILL_TARGETS[@]}"; do
    [ -d "$target" ] || continue
    for src in "$target"/*/; do
      [ -d "$src" ] || continue
      names["$(basename "$src")"]=1
    done
  done

  local rc=0
  for name in "${!names[@]}"; do
    seen=()
    for target in "${SKILL_TARGETS[@]}"; do
      dest="$target/$name"
      [ -d "$dest" ] || continue
      record=$(record_path "skill-$(slug "$dest")")
      if [ -d "$SRC_SKILLS/$name" ]; then
        action=$(classify tree "$SRC_SKILLS/$name" "$dest" "$record")
      else
        cur=$(tree_hash "$dest")
        recorded=$(cat "$record" 2>/dev/null || true)
        if [ -n "$recorded" ] && [ "$cur" = "$recorded" ]; then action=current; else action=local-edit; fi
      fi
      if [ "$action" = local-edit ]; then
        seen["$(tree_hash "$dest")"]+="$dest "
      fi
    done
    if [ "${#seen[@]}" -eq 0 ]; then
      continue
    elif [ "${#seen[@]}" -eq 1 ]; then
      local hash first=""
      for hash in "${!seen[@]}"; do first="${seen[$hash]%% *}"; done
      [ -d "$SRC_SKILLS/$name" ] && backup "$SRC_SKILLS/$name"
      rm -rf "$SRC_SKILLS/$name"
      mkdir -p "$SRC_SKILLS/$name"
      cp -a "$first/." "$SRC_SKILLS/$name/"
      echo "skill:      captured $name <- $first"
    else
      echo "skill:      $name: targets disagree; resolve by hand" >&2
      for h in "${!seen[@]}"; do echo "  ${seen[$h]% }" >&2; done
      rc=1
    fi
  done

  if [ "$rc" = 0 ]; then
    echo "done. Review: git -C $REPO diff"
  fi
  return "$rc"
}

case "$MODE" in
  sync) do_sync ;;
  check) do_sync ;;
  capture) do_capture ;;
esac
